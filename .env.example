# RunPod API credentials (falls back to ~/.runpod/config.toml if omitted)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Container image for RunPod Serverless Worker
WORKER_IMAGE=ghcr.io/logos333/minimax-h3-worker:latest

# RunPod deployment defaults
RUNPOD_DATACENTER_ID=US-TX-3
RUNPOD_VOLUME_NAME=minimax-h3-models
RUNPOD_VOLUME_SIZE_GB=60
RUNPOD_TEMPLATE_NAME=minimax-h3-serverless-template
RUNPOD_ENDPOINT_NAME=minimax-h3-serverless
# Comma-separated RunPod Serverless GPU pools (priority order)
RUNPOD_GPU_IDS=AMPERE_80,ADA_48_PRO,ADA_80_PRO
RUNPOD_WORKERS_MIN=0
RUNPOD_WORKERS_MAX=3
RUNPOD_IDLE_TIMEOUT_SEC=10
RUNPOD_EXECUTION_TIMEOUT_MS=600000

# Optional S3 / Cloudflare R2 storage for output videos (if omitted, worker returns base64)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional Hugging Face token (only needed if using gated repos or hitting rate limits)
HF_TOKEN=
